{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anime Watcher",
  "version": "1.0.0",
  "identifier": "com.evilrender23.animewatcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anime Watcher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0c0e14"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "frame-src": "https: http:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Ver animé subtitulado al español",
    "longDescription": "Busca y reproduce animé subtitulado al español desde MonosChinos.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Spanish", "English"], "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMzM0QzYzNjlDNUUwQUQKUldTdDRNVnBZMHd6VWhhc25TTlhyS2NwNTNiK1U5V1FSOFI3VE9uTjR0Z1l6aUgrelZjUm5OemIK",
      "endpoints": ["https://github.com/evilrender23/Anime-Watcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
